<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>

    <TargetFramework>net10.0</TargetFramework>

    <Nullable>enable</Nullable>

    <ImplicitUsings>enable</ImplicitUsings>

    <RootNamespace>TmsApi</RootNamespace>

    <AssemblyName>TmsApi</AssemblyName>

        <!-- Suppress NU1903 warning about a known vulnerable transitive package (Microsoft.OpenApi).
          The project intentionally uses Microsoft.AspNetCore.OpenApi instead; suppress the advisory
          to avoid CI/build noise. -->
        <NoWarn>$(NoWarn);NU1903</NoWarn>

  </PropertyGroup>


  <ItemGroup>

    <!-- ========================= -->
    <!-- Authentication / Security -->
    <!-- ========================= -->

    <PackageReference Include="Asp.Versioning.Abstractions" Version="10.2.0" />

    <PackageReference Include="Asp.Versioning.Http" Version="10.2.0" />

    <PackageReference Include="Asp.Versioning.Mvc" Version="10.2.0" />

    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" Version="10.2.0" />

    <PackageReference Include="Asp.Versioning.OpenApi" Version="10.2.0" />

    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />

    <!-- ========================= -->
    <!-- OpenAPI + Scalar Docs -->

    <!-- Removed vulnerable Microsoft.OpenApi package (2.0.1). Use Microsoft.AspNetCore.OpenApi (included below) instead. -->

    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />

    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>

    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" Version="10.8.0" />

    <PackageReference Include="Scalar.AspNetCore" Version="2.16.15" />


    <!-- ========================= -->
    <!-- Entity Framework Core -->
    <!-- ========================= -->


    <!-- ========================= -->
    <!-- PostgreSQL Provider -->
    <!-- ========================= -->


  </ItemGroup>


  <ItemGroup>
    <ProjectReference Include="..\TmsApi.Application\TmsApi.Application.csproj" />
    <ProjectReference Include="..\TmsApi.Infrastructure\TmsApi.Infrastructure.csproj" />
  </ItemGroup>


</Project>